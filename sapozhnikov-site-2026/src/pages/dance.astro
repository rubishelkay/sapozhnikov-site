---
import BaseLayout from "../layouts/BaseLayout.astro";
import IndexMenu from "../components/IndexMenu.astro";

import manifest from "../../public/assets/images/dance/manifest.json";
import text from "../../public/assets/images/dance/text.json";

/*
  1:1 port of https://sergeysapozhnikov.ru/dance/

  The original ReadyMag page is an artistic absolute-positioned collage
  on a 1024 x 20358 px stage. Every image, video and text block keeps
  its exact left/top/width/height. On smaller viewports the whole stage
  is uniformly scaled with `transform: scale()` so the composition is
  preserved on mobile.
*/

const STAGE_W = 1024;
const STAGE_H = 20358;

const RU_BLOCK = { left: 162, top: 127,   w: 680, h: 5118, z: 301 };
const EN_BLOCK = { left: 162, top: 15643, w: 680, h: 4628, z: 336 };
---
<BaseLayout
  title="Dance (2015–2017)"
  description="Sergey Sapozhnikov. Dance (2015–2017). Двуязычное эссе и серия фотографий и видео, посвящённая работе с танцовщиком Сашей Кисловым."
  bodyClass="page-dance"
  noChrome
>
  <IndexMenu />

  <div class="stage-wrap">
    <div
      class="stage"
      style={`width:${STAGE_W}px; height:${STAGE_H}px;`}
    >
      <article
        class="text ru"
        style={`left:${RU_BLOCK.left}px; top:${RU_BLOCK.top}px; width:${RU_BLOCK.w}px; min-height:${RU_BLOCK.h}px; z-index:${RU_BLOCK.z};`}
      >
        <h1>{text.title}</h1>
        {text.ru_paragraphs.map((p: string) => (
          /^\d+$/.test(p.trim())
            ? <p class="section-num">{p}</p>
            : <p>{p}</p>
        ))}
      </article>

      {manifest.map((item: any, i: number) => {
        const style = `left:${item.left}px; top:${item.top}px; width:${item.w}px; height:${item.h}px;`;
        if (item.kind === "image") {
          return (
            <figure class="media image" style={style}>
              <img
                src={`/assets/images/dance/${item.file}`}
                alt={`Sergey Sapozhnikov, Dance, work ${i + 1}`}
                loading={item.top < 7000 ? "eager" : "lazy"}
                decoding="async"
              />
            </figure>
          );
        }
        return (
          <div class="media video" style={style}>
            <iframe
              src={`https://www.youtube.com/embed/${item.youtubeId}?autoplay=1&mute=1&playsinline=1&controls=1&rel=0&modestbranding=1&iv_load_policy=3&enablejsapi=1`}
              title={`Sergey Sapozhnikov, Dance, video ${i + 1}`}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>
        );
      })}

      <article
        class="text en"
        style={`left:${EN_BLOCK.left}px; top:${EN_BLOCK.top}px; width:${EN_BLOCK.w}px; min-height:${EN_BLOCK.h}px; z-index:${EN_BLOCK.z};`}
      >
        {text.en_paragraphs.map((p: string) => (
          /^\d+$/.test(p.trim())
            ? <p class="section-num">{p}</p>
            : <p>{p}</p>
        ))}
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  :global(body.page-dance) {
    margin: 0;
    background: #ffffff;
    color: #222222;
    font-family: Roboto, -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
  }

  :global(body.page-dance main) {
    display: block;
  }

  /*
    The original ReadyMag canvas is 1024px wide; the stage sits centred
    in the viewport. Beyond ~1024px the layout pads symmetrically.
  */
  .stage-wrap {
    width: 100%;
    overflow-x: hidden;
    overflow-y: visible;
    display: flex;
    justify-content: center;
  }

  .stage {
    position: relative;
    flex: 0 0 auto;
    transform-origin: top center;
  }

  .media,
  .text {
    position: absolute;
    margin: 0;
    box-sizing: border-box;
  }

  .media.image img,
  .media.video iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }

  .text {
    color: #222222;
  }

  .text h1 {
    margin: 0 0 28px;
    font-size: 30px;
    line-height: 40px;
    font-weight: 400;
  }

  .text p {
    margin: 0 0 24px;
    font-size: 16px;
    line-height: 24px;
    font-weight: 300;
  }

  .text p.section-num {
    margin-top: 24px;
    font-size: 24px;
    line-height: 32px;
    font-weight: 400;
  }

  /*
    Scale the whole stage proportionally on viewports narrower than the
    1024 px canvas. The wrapper itself stays full-viewport so the
    document height collapses to the scaled stage height.
  */
  @media (max-width: 1024px) and (min-width: 721px) {
    .stage {
      --scale: calc(100vw / 1024px);
      transform: scale(var(--scale));
    }
    .stage-wrap {
      height: calc(20358 * 100vw / 1024);
    }
  }

  /*
    Mobile (<= 720px) — match the original sergeysapozhnikov.ru behaviour:
    a single long column. Drop absolute positioning and let everything
    flow naturally in document order: RU narrative -> photos & videos
    (in their original top-to-bottom order) -> EN narrative.
  */
  @media (max-width: 720px) {
    .stage-wrap {
      width: 100%;
      padding: 24px 20px 64px;
      box-sizing: border-box;
    }
    .stage {
      width: 100% !important;
      height: auto !important;
      display: flex;
      flex-direction: column;
      gap: 16px;
      transform: none;
    }
    .media,
    .text {
      position: static !important;
      width: 100% !important;
      height: auto !important;
      min-height: 0 !important;
      max-width: 100%;
      left: auto !important;
      top: auto !important;
    }
    .text.ru {
      margin-bottom: 24px;
    }
    .text.en {
      margin-top: 24px;
    }
    .text h1 {
      font-size: 22px;
      line-height: 30px;
    }
    .media.image {
      aspect-ratio: auto;
    }
    .media.image img {
      width: 100%;
      height: auto;
      object-fit: contain;
    }
    .media.video {
      aspect-ratio: 16 / 9;
    }
    .media.video iframe {
      width: 100%;
      height: 100%;
    }
  }
</style>
