---
import BaseLayout from "../layouts/BaseLayout.astro";
import IndexMenu from "../components/IndexMenu.astro";

import manifest from "../../public/assets/images/senza-titolo/manifest.json";

/*
  1:1 port of https://sergeysapozhnikov.ru/senza_titolo/

  Original ReadyMag stage: 1024 × 14582 px. Title at top:127, then a long
  artistic collage of 38 photos and 1 video, each placed at exact
  left/top/width/height with z-index ordering. Below 1024 px the stage
  scales uniformly; on phones it becomes a single-column long scroll.
*/

const STAGE_W = 1024;
const STAGE_H = 14582;

const TITLE_BLOCK = { left: 162, top: 127, w: 680, h: 90, z: 301 };
---
<BaseLayout
  title="Senza Titolo (2017)"
  bodyClass="page-senza"
  noChrome
>
  <IndexMenu />

  <div class="stage-wrap">
    <div
      class="stage"
      style={`width:${STAGE_W}px; height:${STAGE_H}px;`}
    >
      <header
        class="text title"
        style={`left:${TITLE_BLOCK.left}px; top:${TITLE_BLOCK.top}px; width:${TITLE_BLOCK.w}px; min-height:${TITLE_BLOCK.h}px; z-index:${TITLE_BLOCK.z};`}
      >
        <h1>Senza Titolo (2017)</h1>
      </header>

      {manifest.map((item: any, i: number) => {
        const style = `left:${item.left}px; top:${item.top}px; width:${item.w}px; height:${item.h}px; z-index:${item.z};`;
        if (item.kind === "image") {
          return (
            <figure class="media image" style={style}>
              <img
                src={`/assets/images/senza-titolo/${item.file}`}
                alt={`Sergey Sapozhnikov, Senza Titolo, work ${i + 1}`}
                loading={item.top < 1500 ? "eager" : "lazy"}
                decoding="async"
              />
            </figure>
          );
        }
        return (
          <div class="media video" style={style}>
            <iframe
              src={`https://www.youtube.com/embed/${item.youtubeId}?autoplay=1&mute=1&playsinline=1&controls=1&rel=0&modestbranding=1&iv_load_policy=3&enablejsapi=1`}
              title={`Sergey Sapozhnikov, Senza Titolo, video ${i + 1}`}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  :global(body.page-senza) {
    margin: 0;
    background: #ffffff;
    color: #222222;
    font-family: Roboto, -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
  }

  :global(body.page-senza main) {
    display: block;
  }

  .stage-wrap {
    width: 100%;
    overflow-x: hidden;
    overflow-y: visible;
    display: flex;
    justify-content: center;
  }

  .stage {
    position: relative;
    flex: 0 0 auto;
    transform-origin: top center;
  }

  .media,
  .text {
    position: absolute;
    margin: 0;
    box-sizing: border-box;
  }

  .media.image img,
  .media.video iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }

  .text {
    color: #222222;
  }

  .text h1 {
    margin: 0;
    font-size: 30px;
    line-height: 40px;
    font-weight: 400;
  }

  /* Tablet / intermediate viewports — uniform scale of the 1024px stage. */
  @media (max-width: 1024px) and (min-width: 721px) {
    .stage {
      --scale: calc(100vw / 1024px);
      transform: scale(var(--scale));
    }
    .stage-wrap {
      height: calc(14582 * 100vw / 1024);
    }
  }

  /* Mobile — single-column long scroll. */
  @media (max-width: 720px) {
    .stage-wrap {
      width: 100%;
      padding: 24px 20px 64px;
      box-sizing: border-box;
    }
    .stage {
      width: 100% !important;
      height: auto !important;
      display: flex;
      flex-direction: column;
      gap: 16px;
      transform: none;
    }
    .media,
    .text {
      position: static !important;
      width: 100% !important;
      height: auto !important;
      min-height: 0 !important;
      max-width: 100%;
      left: auto !important;
      top: auto !important;
    }
    .text.title {
      margin-bottom: 8px;
    }
    .text h1 {
      font-size: 22px;
      line-height: 30px;
    }
    .media.image img {
      width: 100%;
      height: auto;
      object-fit: contain;
    }
    .media.video {
      aspect-ratio: 16 / 9;
    }
    .media.video iframe {
      width: 100%;
      height: 100%;
    }
  }
</style>
