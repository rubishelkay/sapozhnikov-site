---
// Minimal photo grid. Pass an array of images, each with src/alt and optional
// width/height. Native lazy-loading, no JS.

interface ImageItem {
  src: string;
  alt?: string;
  width?: number;
  height?: number;
  caption?: string;
}

interface Props {
  items: ImageItem[];
  /** Number of columns at desktop. Defaults to 1 (single column, full-width). */
  columns?: 1 | 2 | 3;
}

const { items, columns = 1 } = Astro.props;
---
<section class={`gallery cols-${columns}`}>
  {items.map((item) => (
    <figure>
      <img
        src={item.src}
        alt={item.alt ?? ""}
        width={item.width}
        height={item.height}
        loading="lazy"
        decoding="async"
      />
      {item.caption && <figcaption>{item.caption}</figcaption>}
    </figure>
  ))}
</section>

<style>
  .gallery {
    display: grid;
    gap: var(--space-6);
    margin: var(--space-8) 0;
  }

  .cols-1 { grid-template-columns: 1fr; }
  .cols-2 { grid-template-columns: repeat(2, 1fr); }
  .cols-3 { grid-template-columns: repeat(3, 1fr); }

  figure {
    margin: 0;
  }

  figcaption {
    margin-top: var(--space-2);
    color: var(--color-fg-muted);
    font-size: var(--fs-sm);
  }

  @media (max-width: 720px) {
    .cols-2,
    .cols-3 { grid-template-columns: 1fr; }
  }
</style>
