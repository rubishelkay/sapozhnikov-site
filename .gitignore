# --- Project rule: NEVER commit large files to GitHub ---
# Hard ceiling on any single file is 25 MB; enforced by .githooks/pre-commit.
# Common large-file types are excluded explicitly below.

# --- Source / reference material that lives only locally ---
# Original ReadyMag PDF export (~600 MB), not for git.
source/redymag-pdf-site2020/*.pdf
source/redymag-pdf-site2020/**/*.pdf
# PDF-derived high-res output goes to local-only folder.
source/pdf-derived/

# Original (high-res) photographs from Sergey, when received.
site/public/images/**/original/
site/src/assets/originals/

# Local visual-regression screenshots are an artifact, regenerate on demand.
source/parse-1/screenshots/
**/screenshots/local-*.png

# --- Common heavy media that has no business in git ---
*.tif
*.tiff
*.psd
*.psb
*.ai
*.eps
*.raw
*.cr2
*.cr3
*.nef
*.arw
*.dng
*.heic
*.heif
*.mov
*.mp4
*.m4v
*.webm
*.mkv
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.tgz

# --- Node / Astro build output ---
node_modules/
**/node_modules/
site/dist/
site/.astro/
site/.cache/
.cache/
.parcel-cache/

# --- Logs and dev artifacts ---
.playwright-cli/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- OS / editor noise ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# --- Env / secrets ---
.env
.env.*
!.env.example
