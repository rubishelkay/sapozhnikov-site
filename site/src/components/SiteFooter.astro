---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="row">
    <a href="mailto:sapo21@yandex.ru">sapo21@yandex.ru</a>
    <a href="https://www.instagram.com/sergey_sap_sapozhnikov/" rel="noopener external" target="_blank">Instagram</a>
    <a href="https://smartart.ru/sergey-sapozhnikov" rel="noopener external" target="_blank">Smart Art</a>
  </div>
  <div class="row muted">
    © {year} Sergey Sapozhnikov
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-24);
    padding: var(--space-12) var(--gutter) var(--space-16);
    border-top: 1px solid var(--color-rule);
    color: var(--color-fg-muted);
    font-size: var(--fs-sm);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-bottom: var(--space-2);
  }

  .muted {
    color: var(--color-fg-muted);
  }
</style>
