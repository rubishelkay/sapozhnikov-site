---
import { projects, infoLinks } from "../data/projects";

const here = Astro.url.pathname.replace(/\/+$/, "/");

function isActive(href: string) {
  return href === "/" ? here === "/" : here === href;
}
---
<nav class="projects-menu" aria-label="Site navigation">
  <details class="group" open>
    <summary>Projects</summary>
    <ul>
      {projects.map((p) => (
        <li>
          <a href={p.href} aria-current={isActive(p.href) ? "page" : undefined}>
            {p.title}
            {p.hint && <span class="hint">{p.hint}</span>}
          </a>
        </li>
      ))}
    </ul>
  </details>
  <details class="group" open>
    <summary>Info</summary>
    <ul>
      {infoLinks.map((p) => (
        <li>
          <a href={p.href} aria-current={isActive(p.href) ? "page" : undefined}>
            {p.title}
          </a>
        </li>
      ))}
    </ul>
  </details>
</nav>

<style>
  .projects-menu {
    display: flex;
    gap: var(--space-12);
    flex-wrap: wrap;
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  .group > summary {
    list-style: none;
    cursor: pointer;
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: var(--fs-xs);
    margin-bottom: var(--space-2);
  }

  .group > summary::-webkit-details-marker { display: none; }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  a[aria-current="page"] {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hint {
    margin-left: var(--space-2);
    color: var(--color-fg-muted);
    font-size: var(--fs-xs);
  }
</style>
