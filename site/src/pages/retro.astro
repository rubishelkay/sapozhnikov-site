---
import BaseLayout from "../layouts/BaseLayout.astro";
import YouTubeEmbed from "../components/YouTubeEmbed.astro";

// Manifest is generated by source/scripts/download-images.mjs.
// We import it directly so the build fails loudly if it goes missing.
import manifest from "../../public/images/retro/manifest.json";

const photos = manifest.map((m) => `/images/retro/${m.filename}`);
---
<BaseLayout
  title="Retrospective 2003-2018"
  description="Sergey Sapozhnikov. New Tretyakov Gallery, Krymsky Val 10, Moscow. 28.01 — 29.03.2020. Curated by Maria Chiara di Trapani. Works 2003-2018."
  bodyClass="page-retro"
>
  <article class="project">
    <header class="project-head">
      <h1>Sergey Sapozhnikov</h1>
      <p class="venue">New Tretyakov Gallery, Krymsky Val 10, Moscow</p>
      <p class="dates">28.01 — 29.03.2020</p>
      <p class="curator">Curated by Maria Chiara di Trapani</p>
      <p class="period">Works 2003-2018</p>
    </header>

    <div class="photos">
      {photos.map((src, i) => (
        <figure>
          <img src={src} alt={`Sergey Sapozhnikov, retrospective work ${i + 1}`} loading={i === 0 ? "eager" : "lazy"} decoding="async" />
        </figure>
      ))}
    </div>

    <div class="video">
      <YouTubeEmbed id="6GBRIbJjET4" title="Sergey Sapozhnikov, New Tretyakov Gallery — exhibition video" />
    </div>
  </article>
</BaseLayout>

<style>
  .project {
    max-width: var(--container-max);
    margin: var(--space-12) auto;
    padding: 0 var(--gutter);
  }

  .project-head {
    margin-bottom: var(--space-16);
  }

  h1 {
    font-size: var(--fs-xxl);
    line-height: var(--lh-tight);
    margin-bottom: var(--space-6);
  }

  .venue,
  .dates,
  .curator,
  .period {
    margin: 0 0 var(--space-2);
    font-size: var(--fs-md);
    color: var(--color-fg);
  }

  .curator,
  .period {
    color: var(--color-fg-muted);
  }

  .photos {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  figure {
    margin: 0;
  }

  .video {
    margin-top: var(--space-16);
  }
</style>
