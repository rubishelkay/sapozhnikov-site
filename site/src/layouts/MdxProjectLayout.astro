---
import BaseLayout from "./BaseLayout.astro";

// Astro passes MDX frontmatter under `frontmatter`, not flattened, so we
// destructure both for safety.
interface Frontmatter {
  title: string;
  description?: string;
  hint?: string;
}

interface Props {
  frontmatter?: Frontmatter;
  title?: string;
  description?: string;
  hint?: string;
}

const fm = Astro.props.frontmatter ?? {};
const title = Astro.props.title ?? fm.title ?? "Untitled";
const description = Astro.props.description ?? fm.description;
const hint = Astro.props.hint ?? fm.hint;
---
<BaseLayout title={title} description={description} bodyClass="page-mdx-project">
  <article class="mdx-project">
    <header class="head">
      <h1>{title}</h1>
      {hint && <p class="hint">{hint}</p>}
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .mdx-project {
    max-width: 720px;
    margin: var(--space-12) auto;
    padding: 0 var(--gutter);
  }

  .head {
    margin-bottom: var(--space-12);
  }

  h1 {
    font-size: var(--fs-xxl);
    line-height: var(--lh-tight);
    margin-bottom: var(--space-3);
  }

  .hint {
    color: var(--color-fg-muted);
  }

  .prose :global(p) {
    font-size: var(--fs-md);
    line-height: var(--lh-loose);
    margin: 0 0 var(--space-6);
  }

  .prose :global(h2) {
    font-size: var(--fs-xl);
    line-height: var(--lh-tight);
    margin: var(--space-12) 0 var(--space-4);
  }

  .prose :global(h3) {
    font-size: var(--fs-lg);
    margin: var(--space-8) 0 var(--space-3);
  }

  .prose :global(blockquote) {
    margin: var(--space-6) 0;
    padding-left: var(--space-6);
    border-left: 2px solid var(--color-rule);
    color: var(--color-fg-muted);
  }

  .prose :global(figure) {
    margin: var(--space-12) calc(50% - 50vw);
    max-width: 100vw;
  }

  .prose :global(figure img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .prose :global(figcaption) {
    margin-top: var(--space-2);
    font-size: var(--fs-sm);
    color: var(--color-fg-muted);
  }

  @media (max-width: 720px) {
    .prose :global(figure) {
      margin: var(--space-8) 0;
    }
  }
</style>
